autotuner MathIdentityTests -> (int passed, int failed) {
    passed = 0;
    failed = 0;

    start -> __init;

    state test_abs_symmetry (
        TestRunner runner,
        TestContext t
    ) {
        float lhs = Abs(5.0);
        float rhs = Abs(-5.0);

        Error err =
            t.ExpectFloatEq(
                lhs,
                rhs,
                1.0e-6,
                "abs(x) == abs(-x)"
            );

        -> __end(runner, t);
    }

    state test_min_max_identity (
        TestRunner runner,
        TestContext t
    ) {
        float mn = Min(12.0, 5.0);
        float mx = Max(12.0, 5.0);

        Error err =
            t.ExpectFloatEq(
                mn + mx,
                17.0,
                1.0e-6,
                "min/max identity"
            );

        -> __end(runner, t);
    }

    state test_sqrt_square_identity (
        TestRunner runner,
        TestContext t
    ) {
        float x = 7.0;

        float result =
            Sqrt(x * x);

        Error err =
            t.ExpectFloatEq(
                result,
                x,
                1.0e-6,
                "sqrt(x*x) == x"
            );

        -> __end(runner, t);
    }

    state test_max_greater_equal_min (
        TestRunner runner,
        TestContext t
    ) {
        float mn = Min(-2.0, 4.0);
        float mx = Max(-2.0, 4.0);

        Error err =
            t.ExpectTrue(
                mx >= mn,
                "max(x,y) >= min(x,y)"
            );

        -> __end(runner, t);
    }
}
