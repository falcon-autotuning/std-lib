import "../../../testing/testing.fal";
import "../direction.fal";

routine P1() -> (Gate gate) {
    gate =
        Gate.New(
            instrumentPort::InstrumentPort.NewKnob(
                "P1",
                connection::Connection.NewPlungerGate("P1"),
                symbolUnit::SymbolUnit.Volt(),
                "P1 gate",
                "inst 1",
                instrumentPort::Instrument.NewDcVoltageSource(),
            )
        );
}

routine P2() -> (Gate gate) {
    gate =
        Gate.New(
            instrumentPort::InstrumentPort.NewKnob(
                "P2",
                connection::Connection.NewPlungerGate("P2"),
                symbolUnit::SymbolUnit.Volt(),
                "P2 gate",
                "inst 1",
                instrumentPort::Instrument.NewDcVoltageSource(),
            )
        );
}

routine P3() -> (Gate gate) {
    gate =
        Gate.New(
            instrumentPort::InstrumentPort.NewKnob(
                "P3",
                connection::Connection.NewPlungerGate("P3"),
                symbolUnit::SymbolUnit.Volt(),
                "P3 gate",
                "inst 1",
                instrumentPort::Instrument.NewDcVoltageSource(),
            )
        );
}

routine Pi() -> (float value) {
    value = 3.1415926535;
}

autotuner GateStorageTests -> (int passed, int failed) {
    passed = 0;
    failed = 0;

    start -> __init;

    state test_new_preserves_name(
        TestRunner runner,
        TestContext t
    ) {
        Gate gate =
            P1();

        Error err =
            t.ExpectStrEq(
                gate.Name(),
                "P1",
                "gate name preserved"
            );

        -> __end(runner, t);
    }

    state test_port_round_trip(
        TestRunner runner,
        TestContext t
    ) {
        Gate gate =
            P1();

        instrumentPort::InstrumentPort port =
            gate.Port();

        Error err =
            t.ExpectStrEq(
                port.PsuedoName().Name(),
                "P1",
                "port round trip"
            );

        -> __end(runner, t);
    }

    state test_distinct_gate_names(
        TestRunner runner,
        TestContext t
    ) {
        Error err =
            t.ExpectTrue(
                P1().Name() != P2().Name(),
                "distinct gate names"
            );

        -> __end(runner, t);
    }

    state test_connection_name_matches_gate(
        TestRunner runner,
        TestContext t
    ) {
        Gate gate =
            P1();

        Error err =
            t.ExpectStrEq(
                gate.Port()
                    .PsuedoName()
                    .Name(),
                gate.Name(),
                "connection matches gate name"
            );

        -> __end(runner, t);
    }

    state test_gate_deepcopy(
        TestRunner runner,
        TestContext t
    ) {
        Gate gate =
            P1();

        Gate copy =
            gate.DeepCopy();

        Error err =
            t.ExpectStrEq(
                copy.Name(),
                "P1",
                "deepcopy preserves name"
            );

        -> __end(runner, t);
    }
}

autotuner DirectionStorageTests -> (int passed, int failed) {
    passed = 0;
    failed = 0;

    start -> __init;

    state test_new_is_empty (
        TestRunner runner,
        TestContext t
    ) {
        Direction dir = Direction.New();

        Error err =
            t.ExpectTrue(
                dir.IsEmpty(),
                "new direction is empty"
            );

        -> __end(runner, t);
    }

    state test_set_get_coefficient (
        TestRunner runner,
        TestContext t
    ) {
        Direction dir = Direction.New();

        Gate p1 = P1();

        dir.SetCoefficient(
            p1,
                5.0
            );

            float coeff =
                dir.GetCoefficient(p1);

            Error err =
            t.ExpectFloatEq(
                coeff,
                5.0,
                1.0e-6,
                "set/get coefficient"
            );

        -> __end(runner, t);
    }

    state test_contains_gate (
        TestRunner runner,
        TestContext t
    ) {
        Direction dir = Direction.New();

        Gate p1 = P1();

        dir.SetCoefficient(
            p1,
            1.0
        );

        Error err =
            t.ExpectTrue(
                dir.ContainsGate(p1),
                "contains inserted gate"
            );

        -> __end(runner, t);
    }

    state test_remove_gate (
        TestRunner runner,
        TestContext t
    ) {
        Direction dir = Direction.New();

        Gate p1 = P1();

        dir.SetCoefficient(
            p1,
            1.0
        );

        dir.RemoveGate(p1);

        Error err =
            t.ExpectFalse(
                dir.ContainsGate(p1),
                "remove gate works"
            );

        -> __end(runner, t);
    }

    state test_domain_size (
        TestRunner runner,
        TestContext t
    ) {
        Direction dir = Direction.New();

        dir.SetCoefficient(
            P1(),
            1.0
        );

        dir.SetCoefficient(
            P2(),
            2.0
        );

        Error err =
            t.ExpectIntEq(
                dir.DomainSize(),
                2,
                "domain size tracks insertions"
            );

        -> __end(runner, t);
    }
}

autotuner DirectionLinearAlgebraTests -> (int passed, int failed) {
    passed = 0;
    failed = 0;

    start -> __init;

    state test_dot_product (
        TestRunner runner,
        TestContext t
    ) {
        Direction a = Direction.New();
        Direction b = Direction.New();

        Gate p1 = P1();
        Gate p2 = P2();

        a.SetCoefficient(p1, 1.0);
        a.SetCoefficient(p2, 2.0);

        b.SetCoefficient(p1, 3.0);
        b.SetCoefficient(p2, 4.0);

        float dot =
            a.Dot(b);

        Error err =
            t.ExpectFloatEq(
                dot,
                11.0,
                1.0e-6,
                "dot product"
            );

        -> __end(runner, t);
    }

    state test_norm_squared (
        TestRunner runner,
        TestContext t
    ) {
        Direction d = Direction.New();

        d.SetCoefficient(
            P1(),
            3.0
        );

        d.SetCoefficient(
            P2(),
            4.0
        );

        Error err =
            t.ExpectFloatEq(
                d.NormSquared(),
                25.0,
                1.0e-6,
                "norm squared"
            );

        -> __end(runner, t);
    }

    state test_norm (
        TestRunner runner,
        TestContext t
    ) {
        Direction d = Direction.New();

        d.SetCoefficient(
            P1(),
            3.0
        );

        d.SetCoefficient(
            P2(),
            4.0
        );

        Error err =
            t.ExpectFloatEq(
                d.Norm(),
                5.0,
                1.0e-6,
                "3-4-5 norm"
            );

        -> __end(runner, t);
    }

    state test_scale (
        TestRunner runner,
        TestContext t
    ) {
        Direction d = Direction.New();

        Gate p1 = P1();

        d.SetCoefficient(p1, 2.0);

        Direction scaled =
            d.Scale(3.0);

        Error err =
            t.ExpectFloatEq(
                scaled.GetCoefficient(p1),
                6.0,
                1.0e-6,
                "scale multiplies coefficients"
            );

        -> __end(runner, t);
    }

    state test_add (
        TestRunner runner,
        TestContext t
    ) {
        Gate p1 = P1();

        Direction a = Direction.New();
        Direction b = Direction.New();

        a.SetCoefficient(p1, 2.0);
        b.SetCoefficient(p1, 3.0);

        Direction result =
            a.Add(b);

        Error err =
            t.ExpectFloatEq(
                result.GetCoefficient(p1),
                5.0,
                1.0e-6,
                "addition"
            );

        -> __end(runner, t);
    }

    state test_subtract (
        TestRunner runner,
        TestContext t
    ) {
        Gate p1 = P1();

        Direction a = Direction.New();
        Direction b = Direction.New();

        a.SetCoefficient(p1, 7.0);
        b.SetCoefficient(p1, 3.0);

        Direction result =
            a.Subtract(b);

        Error err =
            t.ExpectFloatEq(
                result.GetCoefficient(p1),
                4.0,
                1.0e-6,
                "subtraction"
            );

        -> __end(runner, t);
    }
}

autotuner DirectionIdentityTests -> (int passed, int failed) {
    passed = 0;
    failed = 0;

    start -> __init;

    state test_dot_self_equals_norm_squared (
        TestRunner runner,
        TestContext t
    ) {
        Direction d = Direction.New();

        d.SetCoefficient(
            P1(),
            3.0
        );

        d.SetCoefficient(
            P2(),
            4.0
        );

        Error err =
            t.ExpectFloatEq(
                d.Dot(d),
                d.NormSquared(),
                1.0e-6,
                "dot(v,v)=norm²(v)"
            );

        -> __end(runner, t);
    }

    state test_normalize_unit_vector (
        TestRunner runner,
        TestContext t
    ) {
        Direction d = Direction.New();

        d.SetCoefficient(
            P1(),
            3.0
        );

        d.SetCoefficient(
            P2(),
            4.0
        );

        d.Normalize();

        Error err =
            t.ExpectFloatEq(
                d.Norm(),
                1.0,
                1.0e-6,
                "normalized vector has norm 1"
            );

        -> __end(runner, t);
    }


    state test_normalize_zero_vector (
        TestRunner runner,
        TestContext t
    ) {
        Direction d = Direction.New();

        d.Normalize();

        Error err =
            t.ExpectFloatEq(
                d.Norm(),
                0.0,
                1.0e-6,
                "normalize handles zero vector"
            );

        -> __end(runner, t);
    }

    state test_norm_squared(
        TestRunner runner,
        TestContext t
    ) {
        Direction zero = Direction.New();

        float denom =
            zero.NormSquared();

        Error err =
            t.ExpectFloatEq(
                denom,
                0.0,
                1.0e-6,
                "empty direction norm squared"
            );

        -> __end(runner, t);
    }

    state test_project_onto_zero_vector (
        TestRunner runner,
        TestContext t
    ) {
        Direction d = Direction.New();
        Direction zero = Direction.New();

        d.SetCoefficient(
            P1(),
            5.0
        );

        Direction proj =
            d.Project(zero);

        Error err =
            t.ExpectTrue(
                proj.IsEmpty(),
                "projection onto zero vector"
            );

        -> __end(runner, t);
    }

    state test_is_normalized_after_normalize (
        TestRunner runner,
        TestContext t
    ) {
        Direction d = Direction.New();

        d.SetCoefficient(
            P1(),
            5.0
        );

        d.Normalize();

        Error err =
            t.ExpectTrue(
                d.IsNormalized(1.0e-6),
                "normalized vector reports normalized"
            );

        -> __end(runner, t);
    }

    state test_projection_onto_self (
        TestRunner runner,
        TestContext t
    ) {
        Direction d = Direction.New();

        d.SetCoefficient(
            P1(),
            2.0
        );

        Direction proj =
            d.Project(d);

        Error err =
            t.ExpectFloatEq(
                proj.Dot(d),
                d.Dot(d),
                1.0e-6,
                "projection onto self"
            );

        -> __end(runner, t);
    }

    state test_orthogonal_vectors (
        TestRunner runner,
        TestContext t
    ) {
        Direction x = Direction.New();
        Direction y = Direction.New();

        x.SetCoefficient(
            P1(),
            1.0
        );

        y.SetCoefficient(
            P2(),
            1.0
        );

        Error err =
            t.ExpectTrue(
                x.IsOrthogonal(
                    y,
                    1.0e-6
                ),
                "basis vectors are orthogonal"
            );

        -> __end(runner, t);
    }


    state test_orthogonalize (
        TestRunner runner,
        TestContext t
    ) {
        Direction x = Direction.New();
        Direction y = Direction.New();

        x.SetCoefficient(
            P1(),
            1.0
        );

        y.SetCoefficient(
            P1(),
            1.0
        );

        y.SetCoefficient(
            P2(),
            1.0
        );

        y.Orthogonalize(x);

        Error err =
            t.ExpectTrue(
                y.IsOrthogonal(
                    x,
                    1.0e-6
                ),
                "orthogonalize removes projected component"
            );

        -> __end(runner, t);
    }

    state test_scale_zero (
        TestRunner runner,
        TestContext t
    ) {
        Direction d = Direction.New();

        d.SetCoefficient(
            P1(),
            10.0
        );

        Direction result =
            d.Scale(0.0);

        Error err =
            t.ExpectFloatEq(
                result.NormSquared(),
                0.0,
                1.0e-6,
                "scale by zero produces zero vector"
            );

        -> __end(runner, t);
    }

    state test_rotate_ninety_degrees (
        TestRunner runner,
        TestContext t
    ) {
        Direction dir = Direction.New();

        dir.SetCoefficient(
            P1(),
            1.0
        );

        Direction xAxis = Direction.New();
        xAxis.SetCoefficient(
            P1(),
            1.0
        );

        Direction yAxis = Direction.New();
        yAxis.SetCoefficient(
            P2(),
            1.0
        );

        dir.Rotate(
            Pi() / 2.0,
            xAxis,
            yAxis
        );

        Error err =
            t.ExpectFloatEq(
                dir.GetCoefficient(P1()),
                0.0,
                1.0e-6,
                "rotation moves P1 component to zero"
            );

        err =
            t.ExpectFloatEq(
                dir.GetCoefficient(P2()),
                1.0,
                1.0e-6,
                "rotation moves magnitude into P2"
            );

        -> __end(runner, t);
    }

    state test_rotate_preserves_norm (
        TestRunner runner,
        TestContext t
    ) {
        Gate p1 = P1();
        Gate p2 = P2();

        Direction dir = Direction.New();

        dir.SetCoefficient(
            p1,
            3.0
        );

        dir.SetCoefficient(
            p2,
            4.0
        );

        float before =
            dir.Norm();

        Direction xAxis = Direction.New();
        xAxis.SetCoefficient(P1(), 1.0);

        Direction yAxis = Direction.New();
        yAxis.SetCoefficient(P2(), 1.0);

        dir.Rotate(
            0.731,
            xAxis,
            yAxis
        );

        Error err =
            t.ExpectFloatEq(
                dir.Norm(),
                before,
                1.0e-6,
                "rotation preserves norm"
            );

        -> __end(runner, t);
    }

    state test_rotate_zero_angle (
        TestRunner runner,
        TestContext t
    ) {
        Gate p1 = P1();
        Gate p2 = P2();

        Direction dir = Direction.New();

        dir.SetCoefficient(
            p1,
            3.0
        );

        dir.SetCoefficient(
            p2,
            4.0
        );

        Direction xAxis = Direction.New();
        xAxis.SetCoefficient(P1(), 1.0);

        Direction yAxis = Direction.New();
        yAxis.SetCoefficient(P2(), 1.0);

        dir.Rotate(
            0.0,
            xAxis,
            yAxis
        );

        Error err =
            t.ExpectFloatEq(
                dir.GetCoefficient(p1),
                3.0,
                1.0e-6,
                "zero angle preserves p1"
            );

        err =
            t.ExpectFloatEq(
                dir.GetCoefficient(p2),
                4.0,
                1.0e-6,
                "zero angle preserves p2"
            );

        -> __end(runner, t);
    }

    state test_rotate_preserves_orthogonal_component (
        TestRunner runner,
        TestContext t
    ) {
        Direction dir = Direction.New();

        dir.SetCoefficient(P1(), 1.0);
        dir.SetCoefficient(P2(), 0.0);
        dir.SetCoefficient(P3(), 5.0);

        Direction xAxis = Direction.New();
        xAxis.SetCoefficient(P1(), 1.0);

        Direction yAxis = Direction.New();
        yAxis.SetCoefficient(P2(), 1.0);

        dir.Rotate(
            Pi() / 2.0,
            xAxis,
            yAxis
        );

        Error err =
            t.ExpectFloatEq(
                dir.GetCoefficient(
                    P3()
                ),
                5.0,
                1.0e-6,
                "out of plane component preserved"
            );

        -> __end(runner, t);
    }

    state test_gates_returns_all_inserted_gates (
        TestRunner runner,
        TestContext t
    ) {
        Direction dir = Direction.New();

        Gate p1 = P1();
        Gate p2 = P2();

        dir.SetCoefficient(
            p1,
            1.0
        );

        dir.SetCoefficient(
            p2,
            2.0
        );

        Array<Gate> gates =
            dir.Gates();

        Error err =
            t.ExpectIntEq(
                gates.Size(),
                2,
                "gates returns all inserted gates"
            );

        err =
            t.ExpectTrue(
                dir.ContainsGate(
                    gates.GetIndex(0)
                ),
                "first returned gate belongs to direction"
            );

        err =
            t.ExpectTrue(
                dir.ContainsGate(
                    gates.GetIndex(1)
                ),
                "second returned gate belongs to direction"
            );

        -> __end(runner, t);
    }

    state test_add_disjoint_domains (
        TestRunner runner,
        TestContext t
    ) {
        Direction a = Direction.New();
        Direction b = Direction.New();

        Gate p1 = P1();
        Gate p2 = P2();

        a.SetCoefficient(
            p1,
            1.0
        );

        b.SetCoefficient(
            p2,
            2.0
        );

        Direction result =
            a.Add(b);

        Error err =
            t.ExpectFloatEq(
                result.GetCoefficient(p1),
                1.0,
                1.0e-6,
                "addition preserves first domain"
            );

        err =
            t.ExpectFloatEq(
                result.GetCoefficient(p2),
                2.0,
                1.0e-6,
                "addition preserves second domain"
            );

        err =
            t.ExpectIntEq(
                result.DomainSize(),
                2,
                "addition forms union of domains"
            );

        -> __end(runner, t);
    }

    state test_subtract_disjoint_domains (
        TestRunner runner,
        TestContext t
    ) {
        Direction a = Direction.New();
        Direction b = Direction.New();

        Gate p1 = P1();
        Gate p2 = P2();

        a.SetCoefficient(
            p1,
            1.0
        );

        b.SetCoefficient(
            p2,
            2.0
        );

        Direction result =
            a.Subtract(b);

        Error err =
            t.ExpectFloatEq(
                result.GetCoefficient(p1),
                1.0,
                1.0e-6,
                "subtraction preserves minuend domain"
            );

        err =
            t.ExpectFloatEq(
                result.GetCoefficient(p2),
                -2.0,
                1.0e-6,
                "subtraction negates subtrahend-only domain"
            );

        err =
            t.ExpectIntEq(
                result.DomainSize(),
                2,
                "subtraction forms union of domains"
            );

        -> __end(runner, t);
    }
}
