import "../../../../../testing/testing.fal";
import "../measurementResponse.fal";
import "../../../../math/arrays/labelledArrays/labelledArrays.fal";
import "../../../../math/arrays/labelledMeasuredArray/labelledMeasuredArray.fal";

autotuner MeasurementResponseJSON -> (int passed, int failed) {
    passed = 0;
    failed = 0;

    start -> __init;

    state test_roundtrip (
        TestRunner runner,
        TestContext t
    ) {
        string sample                = SampleJSON();
        MeasurementResponse orig     = MeasurementResponse.FromJSON(sample);
        string json                  = orig.ToJSON();
        MeasurementResponse restored = MeasurementResponse.FromJSON(json);

        Error err = t.ExpectTrue(
            orig.Equal(restored),
            "MeasurementResponse JSON roundtrip");

        -> __end(runner, t);
    }

    state test_to_json_non_empty (
        TestRunner runner,
        TestContext t
    ) {
        string sample = SampleJSON();

        MeasurementResponse resp =
            MeasurementResponse.FromJSON(sample);

        string json = resp.ToJSON();

        Error err = t.ExpectStrNe(
            "",
            json,
            "ToJSON is non-empty");

        -> __end(runner, t);
    }

    state test_arrays_returns_labelled_arrays (
        TestRunner runner,
        TestContext t
    ) {
        string sample = SampleJSON();

        MeasurementResponse resp =
            MeasurementResponse.FromJSON(sample);

        LabelledArrays<LabelledMeasuredArray> arrays =
            resp.Arrays();

        Error err = t.ExpectTrue(
            arrays.IsMeasuredArrays(),
            "Arrays() returns measured arrays");

        err = t.ExpectFalse(
            arrays.IsControlArrays(),
            "Arrays() is not control arrays");

        -> __end(runner, t);
    }

    state test_arrays_survive_method_dispatch (
        TestRunner runner,
        TestContext t
    ) {
        string sample = SampleJSON();

        MeasurementResponse resp =
            MeasurementResponse.FromJSON(sample);

        LabelledArrays<LabelledMeasuredArray> arrays =
            resp.Arrays();

        int size = arrays.Size();

        Error err = t.ExpectTrue(
            size >= 0,
            "LabelledArrays method dispatch works");

        -> __end(runner, t);
    }

  // ── Harness (generated by falcon-test — do not edit) ──────────────
  state __init {
    TestRunner runner = TestRunner.New("MeasurementResponseJSON");
    Error err = runner.Register("test_roundtrip");
    err = runner.Register("test_to_json_non_empty");
    err = runner.Register("test_arrays_returns_labelled_arrays");
    err = runner.Register("test_arrays_survive_method_dispatch");
    err = runner.PrintHeader();
    -> __loop(runner);
  }

  state __loop (TestRunner runner) {
    bool more = runner.HasNext();
    if (more) { -> __begin(runner);}
    else      { -> __finish(runner);}
  }

  state __begin (TestRunner runner) {
    TestContext t = runner.BeginCurrent();
    -> __dispatch(runner, t);
  }

  state __dispatch (TestRunner runner, TestContext t) {
    string name = runner.CurrentName();
    if (name == "test_roundtrip") { -> test_roundtrip(runner, t); }
    if (name == "test_to_json_non_empty") { -> test_to_json_non_empty(runner, t); }
    if (name == "test_arrays_returns_labelled_arrays") { -> test_arrays_returns_labelled_arrays(runner, t); }
    if (name == "test_arrays_survive_method_dispatch") { -> test_arrays_survive_method_dispatch(runner, t); }
    Error err = t.Fail("no body for: " + name);
    -> __end(runner, t);
  }

  state __end (TestRunner runner, TestContext t) {
    Error err = runner.EndCurrent(t);
    -> __loop(runner);
  }

  state __finish (TestRunner runner) {
    Error err = runner.PrintSummary();
    passed = runner.PassedCount();
    failed = runner.FailedCount();
    terminal;
  }
}
