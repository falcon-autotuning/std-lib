import (
"../../../math/arrays/labelledMeasuredArrays/labelledMeasuredArrays.fal"
)
ffimport "measurement-response-wrapper.cpp" ("-I/opt/falcon/include/") ("-L/opt/falcon/lib" "-lfalcon_core_cpp")
routine SampleJSON () -> (string json)
struct MeasurementResponse { 
    routine New (array::Array<LabelledMeasuredArray> arrays) -> (MeasurementResponse response)
    routine Arrays -> (array::Array<LabelledMeasuredArray> arrays)
    routine Equal (MeasurementResponse other) -> (bool equal)
    routine NotEqual (MeasurementResponse other) -> (bool notequal)
    routine FromJSON (string json) -> (MeasurementResponse response)
    routine ToJSON -> (string json)
    routine Message -> (string message)
}
