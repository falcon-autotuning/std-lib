import (
  "../../testing/testing.fal"
  "../../falconCore/physics/config/config.fal"
  "../../falconCore/communications/voltageStates/deviceVoltageStates/deviceVoltageStates.fal"
  "../../falconCore/communications/voltageStates/deviceVoltageState/deviceVoltageState.fal"
  "../../falconCore/communications/messages/voltageStatesResponse/voltageStatesResponse.fal"
  "../../falconCore/instrumentInterfaces/names/ports/ports.fal"
  "../../falconCore/instrumentInterfaces/names/instrumentPort/instrumentPort.fal"
  "../../falconCore/instrumentInterfaces/names/instrument/instrument.fal"
  "../../falconCore/physics/deviceStructures/connection/connection.fal"
  "../../falconCore/physics/units/symbolUnit/symbolUnit.fal"
  "../../falconCore/math/point/point.fal"
  "../../collections/map/map.fal"
  "../../collections/array/array.fal"
  "../hub.fal"
  "mockHub/mockHub.fal"
)

autotuner HubCachingTests -> (int passed, int failed) {
    passed = 0; failed = 0;
    start -> __init;

    state test_cache_and_read_config (TestRunner runner, TestContext t) {
        if (!HasDatabaseConnection()) {
            Error err_skip = t.ExpectTrue(true, "Skipped: FALCON_DATABASE_URL not set");
            -> __end(runner, t);
        }
        config::Config cfg = config::Config.Load("device_config.yaml");
        CacheConfig(cfg);
        config::Config read_cfg = ReadConfig(100);
        Error err_match = t.ExpectIntEq(read_cfg.NumUniqueChannels(), cfg.NumUniqueChannels(), "Cached and read config channels match");
        -> __end(runner, t);
    }

    state test_cache_and_read_voltages (TestRunner runner, TestContext t) {
        if (!HasDatabaseConnection()) {
            Error err_skip = t.ExpectTrue(true, "Skipped: FALCON_DATABASE_URL not set");
            -> __end(runner, t);
        }
        connection::Connection conn = connection::Connection.NewPlungerGate("P1");
        symbolUnit::SymbolUnit u = symbolUnit::SymbolUnit.Volt();
        deviceVoltageState::DeviceVoltageState s1 = deviceVoltageState::DeviceVoltageState.New(conn, -0.5, u);
        
        Array<deviceVoltageState::DeviceVoltageState> arr = Array.New();
        arr.PushBack(s1);
        deviceVoltageStates::DeviceVoltageStates states = deviceVoltageStates::DeviceVoltageStates.New(arr);

        CacheDeviceVoltages(states);
        deviceVoltageStates::DeviceVoltageStates read_states = ReadDeviceVoltages(100);
        Error err_match = t.ExpectIntEq(read_states.Size(), 1, "Cached and read voltages size matches");
        -> __end(runner, t);
    }

    state test_safe_voltage_change (TestRunner runner, TestContext t) {
        if (!HasDatabaseConnection()) {
            Error err_skip = t.ExpectTrue(true, "Skipped: FALCON_DATABASE_URL not set");
            -> __end(runner, t);
        }
        config::Config cfg = config::Config.Load("device_config.yaml");
        CacheConfig(cfg);

        connection::Connection conn = connection::Connection.NewPlungerGate("P1");
        symbolUnit::SymbolUnit u = symbolUnit::SymbolUnit.Volt();
        Map<connection::Connection, float> raw_map = Map.New();
        raw_map.Set(conn, -0.5);
        point::Point pt = point::Point.NewFromRaw(raw_map, u);

        bool is_safe = SafeVoltageChange(pt, 100);
        Error err_match = t.ExpectTrue(is_safe, "Voltage -0.5 on P1 should be safe within bounds");
        -> __end(runner, t);
    }
}

autotuner HubCommsTests -> (int passed, int failed) {
    passed = 0; failed = 0;
    start -> __init;

    state test_mock_hub_comms (TestRunner runner, TestContext t) {
        mockHub::MockHub mock = mockHub::MockHub.New();
        bool started = mock.Start(4222);
        Error err_start = t.ExpectTrue(started, "MockHub started successfully on port 4222");

        // 1. Test RequestConfig
        config::Config cfg = config::Config.Load("device_config.yaml");
        mock.SetConfig(cfg);
        config::Config rec_cfg = RequestConfig(3000);
        Error err_cfg = t.ExpectIntEq(rec_cfg.NumUniqueChannels(), cfg.NumUniqueChannels(), "Received config channels match mock");

        // 2. Test RequestPortPayload
        instrumentPort::InstrumentPort knob1 = instrumentPort::InstrumentPort.NewKnob(
            "P1", connection::Connection.NewPlungerGate("P1"), instrument::Instrument.DCVoltageSource(), symbolUnit::SymbolUnit.Volt(), "Plunger 1");
        Array<instrumentPort::InstrumentPort> knob_arr = Array.New();
        knob_arr.PushBack(knob1);
        ports::Ports knobs = ports::Ports.New(knob_arr);

        instrumentPort::InstrumentPort meter1 = instrumentPort::InstrumentPort.NewMeter(
            "M1", connection::Connection.NewOhmic("M1"), instrument::Instrument.Amnmeter(), symbolUnit::SymbolUnit.Ampere(), "Meter 1");
        Array<instrumentPort::InstrumentPort> meter_arr = Array.New();
        meter_arr.PushBack(meter1);
        ports::Ports meters = ports::Ports.New(meter_arr);

        mock.SetPortPayload(knobs, meters);
        ports::Ports rec_knobs;
        ports::Ports rec_meters;
        rec_knobs, rec_meters = RequestPortPayload(3000);
        Error err_knobs = t.ExpectIntEq(rec_knobs.Size(), 1, "Received knobs count matches mock");
        Error err_meters = t.ExpectIntEq(rec_meters.Size(), 1, "Received meters count matches mock");

        // 3. Test RequestDeviceState
        connection::Connection conn = connection::Connection.NewPlungerGate("P1");
        symbolUnit::SymbolUnit u = symbolUnit::SymbolUnit.Volt();
        deviceVoltageState::DeviceVoltageState s1 = deviceVoltageState::DeviceVoltageState.New(conn, -0.75, u);
        Array<deviceVoltageState::DeviceVoltageState> arr = Array.New();
        arr.PushBack(s1);
        deviceVoltageStates::DeviceVoltageStates states = deviceVoltageStates::DeviceVoltageStates.New(arr);
        voltageStatesResponse::VoltageStatesResponse state_resp = voltageStatesResponse::VoltageStatesResponse.New("OK", states);

        mock.SetDeviceState(state_resp);
        voltageStatesResponse::VoltageStatesResponse rec_state = RequestDeviceState(3000);
        Error err_state = t.ExpectIntEq(rec_state.States().Size(), 1, "Received device states count matches mock");

        mock.Stop();
        -> __end(runner, t);
    }
}

